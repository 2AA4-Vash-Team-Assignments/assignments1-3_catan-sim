%% ============================================================
%% Assignment 3 – Extended Domain Model (UML Class Diagram)
%% Three Design Patterns:
%%   Task 1: Command pattern for undo/redo (R3.1)
%%   Task 2: Chain of Responsibility for rule-based AI (R3.2, R3.3)
%%   Task 3: Observer pattern for game state notifications
%% ============================================================

classDiagram
    direction TB

    %% ==================== ENUMERATIONS ====================

    class ResourceType {
        <<enumeration>>
        WOOD
        BRICK
        WHEAT
        ORE
        SHEEP
    }

    class BuildingType {
        <<enumeration>>
        SETTLEMENT
        CITY
    }

    class CommandType {
        <<enumeration>>
        ROLL
        GO
        LIST
        BUILD_SETTLEMENT
        BUILD_CITY
        BUILD_ROAD
        UNDO
        REDO
        UNKNOWN
    }

    class TurnPhase {
        <<enumeration>>
        AWAIT_ROLL
        ROLL_DICE
        ROBBER_DISCARD
        ROBBER_PLACE
        ROBBER_STEAL
        POST_ROLL
        BUILD_OR_TRADE
        AWAIT_GO
    }

    %% ==================== GAME MANAGEMENT ====================

    class CatanGame {
        -currentRound : int
        -longestRoadLength : int
        -diceRollThisTurn : int
        -currentTurnPhase : TurnPhase
        -commandManager : CommandManager
        +play() void
        +setupPhase() void
        +executeRound() boolean
        +executeTurn(player : Player) void
        +rollDice() int
        +distributeResources(diceRoll : int) void
        +handleRollSeven(roller : Player) void
        +checkWinCondition() boolean
        +updateLongestRoad() void
        +tryBuildSettlement(player : Player, nodeId : int) void
        +tryBuildCity(player : Player, nodeId : int) void
        +tryBuildRoad(player : Player, fromId : int, toId : int) void
        +validateSettlementNode(player : Player, nodeId : int) Node
        +validateCityNode(player : Player, nodeId : int) Node
        +validateRoadEdge(player : Player, fromId : int, toId : int) Edge
        +getCommandManager() CommandManager
        +getPlayers() List~Player~
        +addObserver(observer : GameObserver) void
        +getCurrentRound() int
        +getCurrentTurnPhase() TurnPhase
    }

    class Configuration {
        -maxRounds : int
        -humanPlayerId : int
        +getMaxRounds() int
        +getHumanPlayerId() int
        +isHumanGame() boolean
        +load(filePath : String) void
    }

    class Dice {
        +roll() int
    }

    class Bank {
        -supply : Map~ResourceType, Integer~
        +hasEnoughResources(type : ResourceType, amount : int) boolean
        +distributeResource(type : ResourceType, amount : int) void
        +collectResource(type : ResourceType, amount : int) void
        +getRemainingCount(type : ResourceType) int
    }

    class Demonstrator {
        +main(args : String[])$ void
    }

    %% ==================== BOARD & ROBBER ====================

    class Board {
        +initialize() void
        +getTilesForNumber(number : int) List~Tile~
        +getAvailableSettlementNodes(player : Player) List~Node~
        +getAvailableRoadEdges(player : Player) List~Edge~
        +getUpgradeableNodes(player : Player) List~Node~
        +getAvailableSetupNodes() List~Node~
        +calculateLongestRoad(player : Player) int
        +hasRoadSegmentsWithinTwoUnits(player : Player) boolean
        +getRoadSegments(player : Player) List~Set~Edge~~
    }

    class Robber {
        -currentTile : Tile
        +getCurrentTile() Tile
        +placeOn(tile : Tile) void
    }

    class Tile {
        -id : int
        -numberToken : int
        -resourceType : ResourceType
        +getId() int
        +getNumberToken() int
        +getResourceType() ResourceType
        +getAdjacentNodes() List~Node~
    }

    class Node {
        -id : int
        +getId() int
        +isOccupied() boolean
        +getBuilding() Building
        +setBuilding(b : Building) void
        +satisfiesDistanceRule() boolean
        +getAdjacentNodes() List~Node~
        +getAdjacentTiles() List~Tile~
        +getAdjacentEdges() List~Edge~
    }

    class Edge {
        +isOccupied() boolean
        +getRoad() Road
        +setRoad(r : Road) void
        +getEndpoints() List~Node~
    }

    %% ==================== GAME PIECES ====================

    class Building {
        -type : BuildingType
        +getType() BuildingType
        +setType(type : BuildingType) void
        +getOwner() Player
        +getVictoryPoints() int
        +getResourceMultiplier() int
    }

    class Road {
        +getOwner() Player
        +getEdge() Edge
    }

    %% ==================== PLAYER HIERARCHY (OCP, LSP) ====================

    class Player {
        <<abstract>>
        #id : int
        #resources : Map~ResourceType, Integer~
        #remainingSettlements : int
        #remainingCities : int
        #remainingRoads : int
        +getId() int
        +getTotalResourceCards() int
        +getResourceCount(type : ResourceType) int
        +addResource(type : ResourceType, amount : int) void
        +removeResource(type : ResourceType, amount : int) void
        +canBuildRoad() boolean
        +canBuildSettlement() boolean
        +canBuildCity() boolean
        +buildRoad(edge : Edge, bank : Bank) void
        +buildSettlement(node : Node, bank : Bank) void
        +buildCity(node : Node, bank : Bank) void
        +refundRoad() void
        +refundSettlement() void
        +refundCity() void
        +takeTurn(game : CatanGame) void*
    }

    class AgentPlayer {
        -actionChain : AgentActionHandler
        +takeTurn(game : CatanGame) void
        -chooseAction(game : CatanGame) void
    }

    class HumanPlayer {
        -inputReader : HumanInputReader
        -commandParser : CommandParser
        +takeTurn(game : CatanGame) void
    }

    %% ==================== HUMAN INPUT (R2.1, DIP) ====================

    class HumanInputReader {
        <<interface>>
        +readLine() String
        +hasNextLine() boolean
    }

    class ConsoleInputReader {
        -scanner : Scanner
        +readLine() String
        +hasNextLine() boolean
    }

    class CommandParser {
        +parse(input : String) ParsedCommand
    }

    class ParsedCommand {
        -commandType : CommandType
        -nodeId : int
        -fromNodeId : int
        -toNodeId : int
        +getCommandType() CommandType
        +getNodeId() int
        +getFromNodeId() int
        +getToNodeId() int
    }

    %% ==================== GAME STATE EXPORT (R2.2, R2.3) ====================

    class GameStateWriter {
        +write(filePath : String) void
    }

    %% ==================== COMMAND PATTERN (R3.1) ====================

    class Command {
        <<interface>>
        +execute() boolean
        +unexecute() void
    }

    class CommandManager {
        -undoStack : ArrayDeque~Command~
        -redoStack : ArrayDeque~Command~
        -observers : List~GameObserver~
        +execute(cmd : Command) void
        +undo() void
        +redo() void
        +closeTurn() void
        +addObserver(observer : GameObserver) void
        +removeObserver(observer : GameObserver) void
        -notifyObservers() void
    }

    class BuildRoadCommand {
        -player : Player
        -edge : Edge
        -game : CatanGame
        +execute() boolean
        +unexecute() void
    }

    class BuildSettlementCommand {
        -player : Player
        -node : Node
        -game : CatanGame
        +execute() boolean
        +unexecute() void
    }

    class BuildCityCommand {
        -player : Player
        -node : Node
        -game : CatanGame
        +execute() boolean
        +unexecute() void
    }

    class EndTurnCommand {
        +execute() boolean
        +unexecute() void
    }

    %% ==================== CHAIN OF RESPONSIBILITY (R3.2, R3.3) ====================

    class AgentActionHandler {
        <<abstract>>
        #next : AgentActionHandler
        +handle(agent : Player, game : CatanGame, allPlayers : List~Player~) Command
        #tryHandle(agent : Player, game : CatanGame, allPlayers : List~Player~) Command*
    }

    class ExcessCardsHandler {
        #tryHandle(agent : Player, game : CatanGame, allPlayers : List~Player~) Command
    }

    class RoadSegmentHandler {
        #tryHandle(agent : Player, game : CatanGame, allPlayers : List~Player~) Command
    }

    class LongestRoadHandler {
        #tryHandle(agent : Player, game : CatanGame, allPlayers : List~Player~) Command
    }

    class ValueMaximizingHandler {
        #tryHandle(agent : Player, game : CatanGame, allPlayers : List~Player~) Command
    }

    AgentActionHandler <|-- ExcessCardsHandler
    AgentActionHandler <|-- RoadSegmentHandler
    AgentActionHandler <|-- LongestRoadHandler
    AgentActionHandler <|-- ValueMaximizingHandler
    AgentActionHandler --> AgentActionHandler : next
    AgentPlayer "1" *-- "1" AgentActionHandler : actionChain

    %% ==================== OBSERVER PATTERN (Task 3) ====================

    class GameObserver {
        <<interface>>
        +onGameStateChanged() void
    }

    class ConsoleLogObserver {
        +onGameStateChanged() void
    }

    GameObserver <|.. ConsoleLogObserver
    CommandManager "1" *-- "*" GameObserver : observers
    CommandManager ..> GameObserver : notifies

    %% ==================== COMPOSITION ====================

    CatanGame "1" *-- "1" Board
    CatanGame "1" *-- "4" Player
    CatanGame "1" *-- "1" Dice
    CatanGame "1" *-- "1" Bank
    CatanGame "1" *-- "1" Configuration
    CatanGame "1" *-- "1" Robber
    CatanGame "1" *-- "1" CommandManager

    Board "1" *-- "19" Tile
    Board "1" *-- "54" Node
    Board "1" *-- "72" Edge

    Robber "1" --> "0..1" Tile : on

    %% ==================== ASSOCIATIONS ====================

    CatanGame "1" --> "0..1" Player : longestRoadHolder
    CatanGame ..> GameStateWriter : creates

    Tile "1..3" -- "6" Node : adjacentTo
    Node "2" -- "2..3" Edge : connectsTo
    Node "1" -- "0..1" Building : has
    Edge "1" -- "0..1" Road : has
    Building "*" --> "1" Player : ownedBy
    Road "*" --> "1" Player : ownedBy

    HumanPlayer "1" *-- "1" HumanInputReader
    HumanPlayer "1" *-- "1" CommandParser
    CommandParser ..> ParsedCommand : produces
    ParsedCommand --> CommandType

    %% HumanPlayer creates and submits commands to CommandManager
    HumanPlayer ..> CommandManager : submits commands to
    HumanPlayer ..> BuildRoadCommand : creates
    HumanPlayer ..> BuildSettlementCommand : creates
    HumanPlayer ..> BuildCityCommand : creates

    %% CommandManager invokes Command (invoker -> command)
    CommandManager ..> Command : invokes

    %% Concrete commands implement the Command interface
    Command <|.. BuildRoadCommand
    Command <|.. BuildSettlementCommand
    Command <|.. BuildCityCommand
    Command <|.. EndTurnCommand

    %% Concrete commands hold a reference to CatanGame (receiver)
    BuildRoadCommand --> CatanGame : receiver
    BuildSettlementCommand --> CatanGame : receiver
    BuildCityCommand --> CatanGame : receiver

    %% Concrete commands hold a reference to the acting Player
    BuildRoadCommand --> Player : acts on
    BuildSettlementCommand --> Player : acts on
    BuildCityCommand --> Player : acts on

    %% ==================== INHERITANCE ====================

    Player <|-- AgentPlayer
    Player <|-- HumanPlayer
    HumanInputReader <|.. ConsoleInputReader

    %% ==================== DEPENDENCY ====================

    Demonstrator ..> CatanGame : creates
